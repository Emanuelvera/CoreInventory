@page "/products/delete/{id:int}"
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Delete Product</PageTitle>

<h3>Delete Product</h3>

@if (loading)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (product == null)
{
    <p class="text-danger">Product not found.</p>
    <a href="/products" class="btn btn-secondary">Back</a>
}
else
{
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this product?</h4>
    </div>

    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@product.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@product.Name</dd>

        <dt class="col-sm-2">Code</dt>
        <dd class="col-sm-10">@product.Code</dd>

        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">@product.Stock</dd>
    </dl>

    <button @onclick="HandleDelete" class="btn btn-danger">Delete</button>
    <a href="/products" class="btn btn-secondary">Cancel</a>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        product = await ApiService.GetByIdAsync(Id);
        loading = false;
    }

    private async Task HandleDelete()
    {
        await ApiService.DeleteAsync(Id);
        Navigation.NavigateTo("/products");
    }
}
